{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "traces",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "traces",
                "--otlp-insecure", "--traces", "3"
            ]
        },
        {
            "name": "metrics",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "metrics",
                "--otlp-insecure", "--duration", "3s"
            ]
        },
        {
            "name": "logs",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "logs",
                "--otlp-insecure", "--duration", "3s"
            ]
        },
    ]
}